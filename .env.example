# Copia a .env y rellena. Nunca subas .env al repositorio.

# OCR/estructuración con IA (requerida para PDF/imágenes en /convert)
GEMINI_API_KEY=
# (Opcional) Fallback Anthropic Vision
ANTHROPIC_API_KEY=

# Límite de subida en MB (Vercel corta en ~4.5 MB; en el servidor propio puede ser mayor)
MAX_UPLOAD_MB=25

# Herramientas PDF y almacén local (solo servidor propio). Vacío = desactivado.
DATA_DIR=./data
# Días que se conservan los resultados (los originales no caducan)
EXPIRY_DAYS=30
# Registro de eventos en PostgreSQL. Vacío = DATA_DIR/events.jsonl
DATABASE_URL=

PORT=3000
