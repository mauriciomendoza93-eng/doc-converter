# Copia a .env (no se versiona). Todo es opcional salvo lo que uses.

# Web (Vercel) y respaldo directo del CLI
GEMINI_API_KEY=

# CLI/Finder: OmniRoute local reparte entre cuentas gratuitas (Cloudflare, NVIDIA, agy...)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# Opcional: reemplaza la cadena de modelos (separados por coma, en orden de preferencia)
# DOC_CONVERTER_LLM_TEXT_CHAIN=omniroute:agy/claude-sonnet-4-6,gemini:gemini-3-flash-preview
# DOC_CONVERTER_LLM_VISION_CHAIN=omniroute:agy/gemini-3.1-flash-lite,gemini:gemini-3-flash-preview
